# ---- Dashboard auth (single shared login, same model as the original) ----
APP_USERNAME=denise
APP_PASSWORD=change-me-please
SESSION_SECRET=replace-with-a-long-random-string

# ---- Slack integration ----
# Create a Slack app (https://api.slack.com/apps), add a Bot Token with scopes:
#   chat:write, im:write, users:read, users:read.email
# Install to the workspace and paste the Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=xoxb-your-token-here

# Optional: post a summary of the weekly send to a control channel (channel ID, e.g. C0123ABCD)
SLACK_SUMMARY_CHANNEL=

# ---- Weekly reminder schedule ----
# Meeting is every Wednesday; reminders go out Monday morning.
# Cron is evaluated in the timezone below. Default: Monday 08:00 America/New_York (ET).
REMINDER_CRON=0 8 * * 1
REMINDER_TZ=America/New_York
# Set to "true" to actually send on the schedule. If false, the cron only logs a preview.
REMINDER_ENABLED=false

# Port (Heroku sets this automatically)
PORT=3000

# ============================================================================
# KPI COCKPIT (weekly Slack canvas to the LATAM GM) — 6 metrics
# ============================================================================
# Enable the weekly canvas refresh + schedule (defaults to Monday 08:00).
COCKPIT_ENABLED=false
COCKPIT_CRON=0 8 * * 1
COCKPIT_CANVAS_TITLE=LATAM ProServ Weekly Cockpit
# GM (and anyone else) to grant read access + optional DM ping. Comma-separated Slack IDs.
COCKPIT_GM_SLACK_ID=
# Optional channel(s) to share the canvas in. Comma-separated channel IDs.
COCKPIT_CHANNEL=
# Slack app also needs scopes: canvases:write, canvases:read

# ---- KPIs 1-4: Tableau ProServ Scorecard (LATAM) ----
# The ProServ Scorecard uses EMBEDDED data sources, so no API (view-data or VDS)
# can read the KPIs. Default mode is "csv": fill data/latam-kpis.csv weekly.
# (Set TABLEAU_MODE=api only if a published data source / tabbed views appear.)
TABLEAU_MODE=csv
KPI_CSV_FILE=data/latam-kpis.csv
# PAT kept for discovery tooling (scripts/tableau-dump.js) + future API mode:
TABLEAU_HOST=prod-uswest-c.online.tableau.com
TABLEAU_SITE=salesforce
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
TABLEAU_API_VERSION=3.22

# ---- KPI 5: ARI (Apps Script) ----
# PUSH mode (recommended): your Apps Script posts ARI weekly to /api/kpis/ingest.
# Set a shared secret the script sends as `secret` (or x-ingest-secret header).
INGEST_SECRET=change-me-long-random
# PULL mode (only if your org allows "Anyone" access on the Apps Script):
ARI_URL=
ARI_KEY=
ARI_MODE=json
ARI_JSON_PATH=ari
# ARI_VALUE_REGEX=ARI[^0-9]*([0-9.]+)   # only for ARI_MODE=html

# ---- KPI 6: Coworker Activation (ownership matrix, ProServ owners only) ----
# Point at a REACHABLE copy of matriz-ownership-FY28.html (repo path or URL).
OWNERSHIP_FILE=data/matriz-ownership-FY28.html
# OWNERSHIP_URL=https://.../matriz-ownership-FY28.html
