# ---- Dashboard auth (single shared login, same model as the original) ----
APP_USERNAME=denise
APP_PASSWORD=change-me-please
SESSION_SECRET=replace-with-a-long-random-string

# ---- Slack integration ----
# Create a Slack app (https://api.slack.com/apps), add a Bot Token with scopes:
#   chat:write, im:write, users:read, users:read.email
# Install to the workspace and paste the Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=xoxb-your-token-here

# Optional: post a summary of the weekly send to a control channel (channel ID, e.g. C0123ABCD)
SLACK_SUMMARY_CHANNEL=

# ---- Weekly reminder schedule ----
# Meeting is every Wednesday; reminders go out Monday morning.
# Cron is evaluated in the timezone below. Default: Monday 08:00 America/New_York (ET).
REMINDER_CRON=0 8 * * 1
REMINDER_TZ=America/New_York
# Set to "true" to actually send on the schedule. If false, the cron only logs a preview.
REMINDER_ENABLED=false

# Port (Heroku sets this automatically)
PORT=3000
